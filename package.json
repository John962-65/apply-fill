{
  "name": "applyfill",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "ApplyFill 2.0 — 智能简历自动填写引擎 (Resume Auto-Fill Agent)",
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "dev": "pnpm --filter @applyfill/extension dev",
    "dev:testbed": "pnpm --filter @applyfill/testbed dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @applyfill/testbed test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
